PImage img;
PGraphics pg;

float hue;

float TILES_X = 90;
float TILES_Y = TILES_X;
float TILE_W, TILE_H;


PFont font;

String CHARS = "▁▄0▜B▟1▙▄█▓▀▐3▌E▞4▓▒░";
//String CHARS = "▗▘▜▟▙▄▀▐▌▞▚▝▖▛█";
//String CHARS = " ._▂▃▄▅▆▇ ░▒▓█ ▊▋▌▍▎.";
//String CHARS = " ._▂▃▄▀▀▅▆▇░░▒▓█░ ";
//String CHARS = " ┃━┏┓┗┛┣┫┳┻╋ ";
//String CHARS = " ▐░▒▓▔▔▊▋▌▍▎▏";
//String CHARS = " ▁▂▃▄▅▆▇█";
//String CHARS = " ░▒▓█▂▃▄▅▆▇█";
//String CHARS = " ▁▄█▓▒░"; 

color[] palette = {
  #CFF27E, // Lime Green
  #FF220C, // Bright Red
  #868686, // Medium Gray
  #000000, // Black
  #FFFFFF  // White
};

boolean needsRedraw = true;

void setup() {
  size(900, 900, P3D);
  img = loadImage("img/oli.jpg");
  img.resize(width, height);
  font = createFont("IBMPlexMono-Regular.ttf", 1000);
  
  pg = createGraphics(width, height, P3D);
  TILE_W = width / TILES_X;
  TILE_H = height / TILES_Y;
}

void draw() {
  if (needsRedraw) {
    generateImage();
    needsRedraw = false;
  }
}

void generateImage() {
  pg.beginDraw();
  pg.background(palette[3]);
  pg.imageMode(CENTER);
  pg.translate((width / 2), height / 2);
  pg.image(img, 0, 0);
  pg.endDraw();
  
  background(palette[4]);
  noStroke();
  
  textFont(font);
  textSize(12);
  textAlign(CENTER, CENTER);
  translate(TILE_W / 2, TILE_H / 2);
  PImage buffer = pg.get();
  
  // Create random offsets for more interesting patterns
  float offsetX = random(1000);
  float offsetY = random(1000);
  
  for (int x = 0; x < TILES_X; x++) {
    for (int y = 0; y < TILES_Y; y++) {
      int px = int(x * TILE_W);
      int py = int(y * TILE_H);
      
      color c = buffer.get(px, py);
      float b = brightness(c);
      
      // Create static noise pattern
      float staticNoise = noise(x * 0.1 + offsetX, y * 0.1 + offsetY);
      int selector = int(map(b + staticNoise * 40, 0, 255, CHARS.length() - 1, 0));
      selector = constrain(selector, 0, CHARS.length() - 1);
      
      char ch = CHARS.charAt(selector);
      
      // More varied color selection
      color selectedColor;
      float colorRandom = random(1);
      if (b < 15) {
        selectedColor = (colorRandom < 0.5) ? palette[3] : palette[2]; // Mostly black, some gray
      } else if (b > 80) {
        // More varied bright colors
        selectedColor = palette[int(random(3))]; // Use first three colors
      } else {
        // Mix of colors for middle tones
        selectedColor = palette[int(random(1, 4))]; // Mix of red, gray, black
      }
      
      fill(selectedColor);
      push();
      translate(x * TILE_W, y * TILE_H);
      // Add subtle random rotation for some characters
      if (random(1) < 0.1) {
        rotate(random(-0.2, 0.2));
      }
      text(ch, 0, 0);
      pop();
    }
  }
}

void mousePressed() {
  noiseSeed(int(random(10000)));
  needsRedraw = true;
}
