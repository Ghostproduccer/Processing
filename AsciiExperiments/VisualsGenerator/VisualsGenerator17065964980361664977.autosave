PImage img;
PGraphics pg;

float hue;

float TILES_X = 60;
float TILES_Y = TILES_X;
float TILE_W, TILE_H;


PFont font;

//String CHARS = "▁▄0▜B▟1▙▄█▓▀▐3▌E▞4▓▒░";
//String CHARS = "▗▘▜▟▙▄▀▐▌▞▚▝▖▛█";
//String CHARS = " ._▂▃▄▅▆▇ ░▒▓█ ▊▋▌▍▎.";
//String CHARS = " ._▂▃▄▀▀▅▆▇░░▒▓█░ ";
String CHARS = "┃━┏┓┗┛┣┫┳┻╋█▀▄▌▐░▒▓"; // Enhanced character set for more impact

color[] palette = {
  #CFF27E, // Lime Green
  #FF220C, // Bright Red
  #868686, // Medium Gray
  #000000, // Black
  #FFFFFF  // White
};

boolean needsRedraw = true;

void setup() {
  size(900, 900, P3D);
  img = loadImage("img/sonic2.jpg");
  img.resize(width, height);
  font = createFont("IBMPlexMono-Regular.ttf", 1000);
  
  pg = createGraphics(width, height, P3D);
  TILE_W = width / TILES_X;
  TILE_H = height / TILES_Y;
}

void draw() {
  if (needsRedraw) {
    generateImage();
    needsRedraw = false;
  }
}

void generateImage() {
  pg.beginDraw();
  pg.background(palette[3]); // Black
  pg.imageMode(CENTER);
  pg.translate((width / 2), height / 2);
  
  // Add structured glitch effect
  if (random(1) < 0.3) {
    pg.tint(palette[0], 200); // Lime green tint
  } else {
    pg.tint(palette[1], 200); // Red tint
  }
  pg.image(img, random(-3, 3), random(-3, 3));
  pg.endDraw();
  
  background(palette[3]); // Black background
  noStroke();
  
  textFont(font);
  textAlign(CENTER, CENTER);
  translate(TILE_W / 2, TILE_H / 2);
  PImage buffer = pg.get();
  
  float noiseScale = random(0.1, 0.3);
  
  for (int x = 0; x < TILES_X; x++) {
    for (int y = 0; y < TILES_Y; y++) {
      int px = int(x * TILE_W);
      int py = int(y * TILE_H);
      
      // Strategic glitch effect
      if (noise(x * 0.1, y * 0.1) > 0.8) {
        px += int(random(-8, 8));
        py += int(random(-8, 8));
      }
      
      color c = buffer.get(constrain(px, 0, width-1), constrain(py, 0, height-1));
      float b = brightness(c);
      
      // Dynamic pattern based on noise
      float staticNoise = noise(x * noiseScale, y * noiseScale);
      int selector = int(map(b + staticNoise * 50, 0, 255, CHARS.length() - 1, 0));
      selector = constrain(selector, 0, CHARS.length() - 1);
      
      char ch = CHARS.charAt(selector);
      
      // Strategic color selection
      color selectedColor;
      if (b < 60) {
        // Dark areas: Black with occasional gray or red accents
        selectedColor = (random(1) < 0.85) ? palette[3] : 
                       (random(1) < 0.5) ? palette[2] : palette[1];
      } else if (b > 200) {
        // Bright areas: Lime with occasional red
        selectedColor = (random(1) < 0.7) ? palette[0] : palette[1];
      } else {
        // Mid tones: Mix of gray and accent colors
        float r = random(1);
        if (r < 0.5) selectedColor = palette[2];      // Gray
        else if (r < 0.75) selectedColor = palette[0]; // Lime
        else selectedColor = palette[1];               // Red
      }
      
      // Dynamic text sizing for emphasis
      textSize(map(noise(x * 0.1, y * 0.1), 0, 1, 11, 15));
      
      push();
      translate(x * TILE_W, y * TILE_H);
      
      // Dramatic character effects
      if (random(1) < 0.08) {
        // Double-draw effect with palette colors
        fill(palette[1]); // Red
        text(ch, 1, 1);
        fill(palette[0]); // Lime
        text(ch, 0, 0);
      } else {
        fill(selectedColor);
        text(ch, 0, 0);
      }
      pop();
    }
  }
}

void mousePressed() {
  noiseSeed(int(random(10000)));
  needsRedraw = true;
}
